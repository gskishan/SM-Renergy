 "html": "<style>\n    td, p {\n        font-size: 11px;\n    }\n</style>\n\n<!-- Header -->\n<div id=\"header-html\" class=\"hidden-pdf\">\n    <div class=\"letter-head\">\n        <table width=\"100%\">\n            <tr>\n                <td width=\"50%\" style=\"font-size:11px; text-align:justify;\"> {% if doc.company_address == \"Sm Renergy Private Limited-AP\" %}\n    \n\n      <b>SM RENERGY PRIVATE LIMITED</b><br>\nFlat No. 4A,\nBalaji Mangalagiri Chambers, VIP Road,<br>\nVisakhapatnam Andhra Pradesh, PIN Code: 530003 India <br>\n<b>GSTIN:</b> 37AAGCS0062H1ZH,  <b>PAN:</b> AAGCS0062H &nbsp;<br>\n<b>Email:</b> samay@smrenergy.co, srinag@smrenergy.co<br>\n\n        \n        \n        <b>MSME No.:</b> UDYAM-AP-10-0003359, <b>IEC Code</b> 2617501264<br>\n       \n        <b>CIN:</b> U67120AP1998PTC029922, <b>Contact:</b> +91 89777 52224<br>\n        <b>Website:</b> www.smrenergy.co <br>\n       \n    {% endif %}\n     {% if doc.company_address == \"Sm Renergy Private Limited-Delhi\" %}\n    \n\n       <b>SM RENERGY PRIVATE LIMITED</b><br>\n 86-A, 1st Floor, Randhir Complex<br>\nShahpur Jat, New Delhi, South Delhi<br>\nDelhi, State Code: 07, PIN Code: 110049 India<br>\n\n<b>GSTIN:</b>07AAGCS0062H1ZK, <b>PAN:</b> AAGCS0062H <br>\n<b>Email:</b> samay@smrenergy.co, srinag@smrenergy.co<br>\n\n        \n        \n        <b>MSME No.:</b> UDYAM-AP-10-0003359, <b>IEC Code</b> 2617501264<br>\n        <b>CIN:</b> U67120AP1998PTC029922, <b>Contact:</b> +91 89777 52224<br>\n        <b>Website:</b> www.smrenergy.co<br>\n       \n       \n    {% endif %}\n                    \n                </td>\n\n                <td width=\"50%\" style=\"font-size:11px; text-align:left;\">\n                    <img src=\"{{ '/files/SM Renergy Logo.png' | abs_url }}\" \n                         width=\"70%\" \n                         alt=\"Company Logo\">\n                     \n                </td>\n            </tr>\n        </table>\n    </div>\n</div>\n\n\n<!-- Order Info -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <tr>\n        <td colspan=\"2\" style=\"text-align: center; font-weight: bold; font-size: 13px;\">Quotation</td>\n    </tr>\n  <tr>\n    <td width=\"50%\">\n        <b >Client Name: {{doc.customer_name or \"\"}}</b> <br><br><b>Address: </b> <br>{{doc.address_display or \"\"}}\n    </td>\n    <td ><b>Quotation:</b> {{ doc.name or \"\" }}<br><br>\n    <b>Quotation Date:</b> {{ frappe.utils.formatdate(doc.transaction_date, \"dd/mm/yyyy\") or \"\"}}<br><br>\n    <b>Sc.No:</b> {{doc.custom_scno or \"\"}}<br><br>\n    <b>Proposed Capacity under Subsidy </b>: {{doc.custom_proposed_capacity_under_subsidy or \"\"}} <br><br><b>Total Price of the System:</b> {{doc.get_formatted(\"rounded_total\") }}/- \n        <br><br><b>Subsidy Amount to be claimed by Customer:</b> {{ doc.get_formatted(\"custom_subsidy_amount_to_be_claimed_by_customer\") }}\n    </td>\n    \n</tr>\n\n\n\n</table>\n<br>\n<table width=\"100%\" >\n    <tr>\n        <td >\n            <span style=\"font-weight: bold;\">\n              Sales Manager \u2013  {{frappe.db.get_value(\"User\",doc.owner,\"full_name\")}}\n            </span>\n        </td>\n         <td>\n            <span style=\"font-weight: bold;\">\n               Email:  {{frappe.db.get_value(\"User\",doc.owner,\"name\")}}\n            </span>\n        </td>\n         <td >\n            <span style=\"font-weight: bold;\">\n             Ph:  {% set ph = frappe.db.get_value(\"User\",doc.owner,\"mobile_no\") %}\n             {{ph or \"\"}}\n            </span>\n        </td>\n    </tr>\n</table>\n<!-- Item Table -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <thead>\n        <tr>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Sl No.</b></td>\n            <td width=\"30%\" style=\"text-align: center;\"><b>Item Description</b></td>\n            <td width=\"20%\" style=\"text-align: center;\"><b>HSN Code</b></td>\n            <td width=\"20%\" style=\"text-align: center;\"><b>Qty</b></td>\n            <td width=\"20%\" style=\"text-align: center;\"><b>Uom</b></td>\n            \n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.items %}\n        <tr>\n            <td style=\"text-align: center;\">{{ row.idx }}</td>\n            <td><b>{{ row.item_name }}</b><br>{{ row.description }}</td>\n            <td style=\"text-align: center;\">{{ row.gst_hsn_code }}</td>\n            <td style=\"text-align: right;\">{{ row.qty }}</td>\n            <td style=\"text-align: right;\">{{ row.uom }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Total -->\n        <tr>\n            <td colspan=\"4\" style=\"text-align: right;\"><b>Total Taxable Value</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"total\") }}</b></td>\n        </tr>\n\n        <!-- Taxes -->\n        {% for tax in doc.taxes %}\n        <tr>\n            <td colspan=\"4\" style=\"text-align: right;\"><b>{{ tax.description }} </b></td>\n            <td style=\"text-align: right;\">{{ tax.get_formatted(\"tax_amount\", doc) }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Grand Total -->\n        <tr>\n            <td colspan=\"4\" style=\"text-align: right;\"><b>Grand Total</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"rounded_total\") }}</b></td>\n        </tr>\n\n        <!-- In Words -->\n        <tr>\n            <td colspan=\"5\"><b>Total (in words):</b> {{ doc.in_words or \"\" }}</td>\n        </tr>\n    </tbody>\n</table>\n<table width=\"100%\" style=\"font-size:12px; font-weight:bold;\">\n    <tr>\n        <td>Authorized Signature</td>\n    </tr>\n</table><br><br><br>\n\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td width=\"50%\" style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Modules Make /\nTechnology/Quantity</span></td>\n        <td width=\"50%\">{{doc.custom_modules_make__technologyquantity or \"\"}}</td>\n    </tr>\n    <tr>\n        <td style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Inverters Make / Technology</span></td>\n        <td>{{doc.custom_inverters_make__technology or \"\"}}</td>\n    </tr>\n    <tr>\n        <td style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Structure Type</span></td>\n        <td>{{doc.custom_structure_type or \"\"}}</td>\n    </tr>\n    <tr>\n        <td style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Estimated Avg. Units per Year</span></td>\n        <td>{{doc.custom_estimated_avg_units_per_year or \"\"}}</td>\n    </tr>\n</table><br><br>\n<h4>Warranties and Guarantees</h4>\n<table width=\"100%\" border=\"1\">\n    \n    <tr>\n        <td width=\"50%\" style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Modules</span></td>\n        <td width=\"50%\" >{{doc.custom_modules or \"\"}}</td>\n    </tr>\n    <tr>\n        <td style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Inverters</span></td>\n        <td>{{doc.custom_inverters or \"\"}}</td>\n    </tr>\n    <tr>\n        <td style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Balance of System</span></td>\n        <td>{{doc.custom_balance_of_system or \"\"}}</td>\n    </tr>\n    \n</table><br><br>\n<table width=\"100%\" border=\"1\">\n        <td width=\"50%\" style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Bank details</span></td>\n        <td width=\"50%\" style=\"text-align:center;\">{{doc.custom_bank_details_ or \"\"}}</td>\n    </tr>\n</table>\n<br><br>\n<table width=\"100%\" border=\"1\">\n        <td width=\"50%\" style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Payment Terms</span></td>\n        <td width=\"50%\" >{{doc.payment_terms_template or \"\"}}</td>\n    </tr>\n</table>\n<br><br>\n<table width=\"100%\" border=\"1\">\n        <td width=\"50%\" style=\"text-align:right;\"><span style=\"color: #7979d5 !important; font-weight: bold;\">Project Timelines (Weeks)</span></td>\n        <td width=\"50%\" >{{doc.custom_project_timelines_weeks or \"\"}}</td>\n    </tr>\n</table>\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n                Terms and Conditions\n            </span>\n        </td>\n    </tr>\n</table><br>\n{{doc.terms or \"\"}}\n<!--<ol>-->\n<!--    <li>Execution will be started upon recceipt of advance</li>-->\n<!--    <li>Subsidy will be as per Govt. terms and policy</li>-->\n<!--    <li>We will assist in documentation with DISCOM for Net-metering</li>-->\n<!--    <li>AC cable and DC cable will be charged extra as per actuals over and above 25 mtrs.</li>-->\n<!--    <li>Warranty and Guarantee is as per manufacturer</li>-->\n<!--    <li>After sales services shall be as per request from customer</li>-->\n<!--    <li>Rooftop access and water to made available at site for installing and cleaning of modules</li>-->\n<!--    <li>All fees and liasoning charges from feasibility till net metering is not included in our quote</li>-->\n<!--    <li>Offer is valid till 7 days from this date of offer.</li>-->\n<!--</ol>-->\n<br>\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n                Advantages of Solar\n            </span>\n        </td>\n    </tr>\n</table><br>\n<ol>\n    <li>Positive impact on environment</li>\n    <li>Zero carbon emission with green power</li>\n    <li>Initial investment and plant life time free of power</li>\n    <li>Maintenance frindly</li>\n    <li>Long term warranties and guarantees</li>\n</ol><br>\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n                About us\n            </span>\n        </td>\n    </tr>\n</table>\n<br>\n<p style=\"text-align:justify';\">SM Renergy (P) Ltd. is a leading Fast Moving Electrical Goods (FMEG) company having its corporate office in\nVisakhapatnam and branches across India. We are specalised in supply and installation of Solar PV System\nhaving 20,000 Kilo Watt of ground-mounted Solar Power Plants and 10,000 Kilo Watt of Rooftop Solar PV Plants\nexecuted till date.</p><br>\n<p style=\"text-align:justify';\">SMR aims to build, develop and manage a large operating portfolio of distributed solar PV assets in India.</p><br>\n\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n               Our valuable customers\n            </span>\n        </td>\n    </tr>\n</table><br>\n<p style=\"text-align:justify';\">Going forward, SMR aims to prove that solar energy is the most affordable and reliable source of power generation\nfor forward thinking power consumers.</p>\n<img src=\"/files/Screenshot from 2026-04-07 13-21-10.png\" width=\"700mm\"><br><br>\n<table width=\"100%\" >\n    <tr>\n        <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n               {{frappe.db.get_value(\"User\",doc.owner,\"full_name\")}}\n            </span>\n        </td>\n         <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n               Email:  {{frappe.db.get_value(\"User\",doc.owner,\"name\")}}\n            </span>\n        </td>\n         <td style=\"background-color: #7979d5;\">\n            <span style=\"color: #FFFFFF !important; font-weight: bold;\">\n             Ph:  {% set ph = frappe.db.get_value(\"User\",doc.owner,\"mobile_no\") %}\n             {{ph or \"\"}}\n            </span>\n        </td>\n    </tr>\n</table>\n<center><img src=\"/files/IMG-20260407-WA0009.jpg\" style=\"float:center\" width=\"20%\"></center><br><br>\n\n\n<!--<table width=\"100%\" border=\"1\" style=\"font-size: 12px;\">-->\n<!--    <thead>-->\n<!--        <tr style=\"font-weight:bold;text-align:center;\">-->\n<!--            <td width=\"5%\">S.No</td>-->\n<!--            <td width=\"20%\">ITEM</td>-->\n<!--            <td width=\"15%\">MAKE (IF ANY)</td>-->\n<!--            <td width=\"30%\">MODEL & INDIVIDUAL-->\n<!--CAPACITY (IF ANY)</td>-->\n<!--            <td width=\"15%\">QTY</td>-->\n<!--            <td width=\"15%\">UNITS</td>-->\n<!--        </tr>-->\n        \n<!--    </thead>-->\n<!--    <tbody>-->\n<!--        {% for row in doc.items %}-->\n<!--        <tr style=\"text-align:center;\">-->\n<!--            <td>{{ row.idx }}</td>-->\n<!--            <td>{{ row.item_name or \"\" }}</td>-->\n<!--            <td></td>-->\n<!--            <td></td>-->\n<!--            <td>{{row.qty or \"\"}}</td>-->\n<!--            <td>{{row.uom}}</td>-->\n<!--        </tr>-->\n<!--        {% endfor %}-->\n<!--        </tbody>-->\n<!--        </table>-->\n\n\n<!-- Footer -->\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"font-size: 8px; line-height: 1.2;\">\n     <p style=\"text-align: center;font-size: 10px;\"><b>Corporate Office:</b>Flat No. 4A/1, Door No. 9-14-6, 3rd Floor, \n     Balaji's Mangalagiri Chambers, VIP Road, Siripuram, Visakhapatnam \u2013 530003<br>\n\n<b>Delhi Office:</b> 86-A, First Floor, Shahpur Jat, New Delhi \u2013 110049<br>\n<b>CIN:</b> U67120AP1998PTC029922</p>\n    \n    <p class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </p>\n</div>",
