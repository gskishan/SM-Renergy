 "doctype": "Print Format",
 "font_size": 14,
 "html": "<style>\n    td, p {\n        font-size: 12px;\n    }\n</style>\n\n<!-- Header -->\n<div id=\"header-html\" class=\"hidden-pdf\">\n    <div class=\"letter-head\">\n        <table width=\"100%\">\n            <tr>\n                <td width=\"40%\" style=\"font-size:12px; text-align:left;\">\n                    <img src=\"{{ '/files/SM Renergy Logo.png' | abs_url }}\" \n                         width=\"70%\" \n                         alt=\"Company Logo\">\n                </td>\n\n                <td width=\"60%\" style=\"font-size:12px; text-align:right;\">\n                    <b>SM Renergy Private Limited</b><br>\n                    86-A, 1st Floor, Randhir Complex<br>\n                    Shahpur Jat, New Delhi<br>\n                    South Delhi, State Code: 07<br>\n                    <b>PIN Code:</b> 110049<br>\n                    <b>GSTIN:</b> 07AAGCS0062H1ZK\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>\n\n<!-- Order Info -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <tr>\n        <td colspan=\"2\" style=\"text-align: center; font-weight: bold; font-size: 13px;\">TRADING SALES ORDER</td>\n    </tr>\n  <tr>\n    <td width=\"50%\">\n        <b>To: Billing</b><br>\n        {{ doc.customer or \"\" }}<br>\n        {{ doc.address_display or \"\" }}\n    </td>\n    <td width=\"50%\">\n        <b>To: Shipping</b><br>\n<b>{{ (doc.shipping_address_name or \"\").replace(\"-Billing-1\", \"\").replace(\"Billing\", \"\").replace(\"-\", \"\").replace(\"-1\",\"\") }}</b><br>\n        {{ doc.shipping_address or \"\"}}\n    </td>\n</tr>\n<tr>\n    <td width=\"50%\">\n        <b>EXT. OA NO:</b>\n        {{ doc.name or \"\" }}\n    </td>\n    <td width=\"50%\">\n        <b>Delivery Date:</b>\n        {{ frappe.utils.formatdate(doc.delivery_date, \"dd/mm/yyyy\") if doc.delivery_date else \"\" }}\n    </td>\n</tr>\n<tr>\n    <td width=\"50%\">\n        <b>PO No. :</b>\n        {{ doc.po_no or \"\" }}\n    </td>\n    <td width=\"50%\">\n        <b>PO Date:</b>\n        {{ frappe.utils.formatdate(doc.po_date, \"dd/mm/yyyy\") if doc.po_date else \"\" }}\n    </td>\n</tr>\n    {% set dn = frappe.get_doc(\"Quotation\", doc.items[0].prevdoc_docname) if doc.items and doc.items[0].prevdoc_docname else None %}\n\n<tr>\n    <td width=\"50%\">\n        <b>Quotation:</b>{{ dn.name or \"\" }}<br>\n    </td>\n    <td width=\"50%\">\n        <b>Quotation Date:</b>{{ frappe.utils.formatdate(dn.transaction_date, \"dd/mm/yyyy\") or \"\"}}\n    </td>\n</tr>\n</table>\n<br>\n<p>We refer to the above purchase order and are pleased to issue our External Order Acceptance as follows</p>\n<!-- Item Table -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <thead>\n        <tr>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Sl No.</b></td>\n            <td width=\"40%\" style=\"text-align: center;\"><b>Item Description</b></td>\n            <td width=\"20%\" style=\"text-align: center;\"><b>HSN Code</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Qty</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Rate</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Total ({{ doc.currency }})</b></td>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.items %}\n        <tr>\n            <td style=\"text-align: center;\">{{ row.idx }}</td>\n            <td>{{ row.item_code }}<br>{{ row.description }}</td>\n            <td style=\"text-align: center;\">{{ row.gst_hsn_code }}</td>\n            <td style=\"text-align: right;\">{{ row.qty }}</td>\n            <td style=\"text-align: right;\">{{ row.rate }}</td>\n            <td style=\"text-align: right;\">{{ row.get_formatted(\"amount\", doc) }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Total -->\n        <tr>\n            <td colspan=\"5\" style=\"text-align: right;\"><b>Total</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"total\") }}</b></td>\n        </tr>\n\n        <!-- Taxes -->\n        {% for tax in doc.taxes %}\n        <tr>\n            <td colspan=\"5\" style=\"text-align: right;\"><b>{{ tax.description }}  @{{ tax.rate }}%</b></td>\n            <td style=\"text-align: right;\">{{ tax.get_formatted(\"tax_amount\", doc) }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Grand Total -->\n        <tr>\n            <td colspan=\"5\" style=\"text-align: right;\"><b>Grand Total</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"rounded_total\") }}</b></td>\n        </tr>\n\n        <!-- In Words -->\n        <tr>\n            <td colspan=\"6\"><b>Total (in words):</b> {{ doc.in_words or \"\" }}</td>\n        </tr>\n    </tbody>\n</table>\n\n<!-- Terms & Conditions -->\n{% if doc.custom_terms_and_conditions_ %}\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px; font-size: 12px;\">\n    <tr>\n        <td colspan=\"2\" style=\"font-weight: bold;\">Terms & Conditions</td>\n    </tr>\n    {% for t in doc.custom_terms_and_conditions_ %}\n    <tr>\n        <td width=\"25%\" style=\"font-weight: bold;\">{{ t.terms }}</td>\n        <td width=\"75%\">{{ t.terms_value or \"\" }}</td>\n    </tr>\n    {% endfor %}\n        <td colspan=\"2\">\n            Explicit Terms & Conditions of Annexure replaces General Purchase Conditions wherever applicable. - Accepted<br>\n        </td>\n    </tr>\n     <tr>\n        <td colspan=\"2\">\n            If OA is not submitted within 7 days, it is presumed that the delivery date is acceptable.\n        </td>\n    </tr>\n    \n    <tr>\n        <td colspan=\"1\" style=\"text-align: center;\"><br>(Prepared By)</td>\n        <td colspan=\"1\" style=\"text-align: center;\"><br>(Approved By)</td>\n    </tr>\n    <tr>\n        <td colspan=\"2\" style=\"text-align: center;\"><b>MARKETING Dept</b></td>\n    </tr>\n</table>\n{% endif %}\n<!-- Signature -->\n\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;font-size:12px;\">\n      <tr>\n    <td colspan=\"2\" style=\"font-weight: bold;\" >\n      Bank Details : -  \n    </td>\n    </tr>\n    \n    <tr>\n        <td width=\"50%\"><b>Bank Name</b></td>\n        <td width=\"50%\">ICICI Bank</td>\n    </tr>\n    <tr>\n        <td><b>Bank Account No.</b></td>\n         <td>249405002208</td>\n    </tr>\n    <tr>\n        <td><b>IFSC Code</b></td>\n         <td>ICIC0002429</td>\n    </tr>\n    <tr>\n        <td  rowspan=\"2\" style=\"text-align: right; font-weight: bold;\" colspan=\"2\">\n            For SM Renergy Private Limited<br><br><br><br>Authorised Signatory\n        </td>\n    </tr>\n</table>\n\n<!-- Footer -->\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"font-size: 8px; line-height: 1.2;\">\n    <p style=\"text-align: center;\">This is a computer-generated Order Acceptance. Signature is not required.</p>\n    {% if not no_letterhead and footer %}\n    <div class=\"letter-head-footer\">{{ footer }}</div>\n    {% endif %}\n    <p class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </p>\n</div>\n",
