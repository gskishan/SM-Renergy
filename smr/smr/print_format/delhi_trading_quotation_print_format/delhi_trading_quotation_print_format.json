 "html": "<style>\n    td, p {\n        font-size: 12px;\n    }\n</style>\n\n<!-- Header -->\n<div id=\"header-html\" class=\"hidden-pdf\">\n    <div class=\"letter-head\">\n        <table width=\"100%\">\n            <tr>\n                <td width=\"40%\" style=\"font-size:12px; text-align:left;\">\n                    <img src=\"{{ '/files/SM Renergy Logo.png' | abs_url }}\" \n                         width=\"70%\" \n                         alt=\"Company Logo\">\n                </td>\n\n                <td width=\"60%\" style=\"font-size:12px; text-align:right;\">\n                    <b>SM RENERGY PRIVATE LIMITED</b><br>\n 86-A, 1st Floor, Randhir Complex<br>\nShahpur Jat, New Delhi,\n<br>\nDelhi, State Code: 07<br>\nPIN Code: 110049 India<br>\nsrinag@smrenergy.co<br>\n        \n        <b>GSTIN:</b>07AAGCS0062H1ZK<br>\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>\n\n<!-- Order Info -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <tr>\n        <td colspan=\"2\" style=\"text-align: center; font-weight: bold; font-size: 13px;\">SALES ORDER</td>\n    </tr>\n  <tr>\n    <td width=\"50%\">\n        <b>To: Billing</b><br>\n        {{ doc.customer or \"\" }}<br>\n        {{ doc.address_display or \"\" }}\n    </td>\n    <td width=\"50%\">\n        <b>To: Shipping</b><br>\n<b>{{ (doc.shipping_address_name or \"\").replace(\"-Billing-1\", \"\").replace(\"Billing\", \"\").replace(\"-\", \"\").replace(\"-1\",\"\") }}</b><br>\n        {{ doc.shipping_address or \"\"}}\n    </td>\n</tr>\n\n\n<tr>\n    <td width=\"50%\">\n        <b>Quotation:</b>{{ doc.name or \"\" }}<br>\n    </td>\n    <td width=\"50%\">\n        <b>Quotation Date:</b>{{ frappe.utils.formatdate(doc.transaction_date, \"dd/mm/yyyy\") or \"\"}}\n    </td>\n</tr>\n</table>\n<br>\n<p>We refer to your purchase order and are pleased to issue our External Order Acceptance as follows</p>\n<!-- Item Table -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse; margin-top: 10px;\">\n    <thead>\n        <tr>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Sl No.</b></td>\n            <td width=\"30%\" style=\"text-align: center;\"><b>Item Description</b></td>\n            <td width=\"20%\" style=\"text-align: center;\"><b>HSN Code</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Qty</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Uom</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Rate</b></td>\n            <td width=\"10%\" style=\"text-align: center;\"><b>Total ({{ doc.currency }})</b></td>\n        </tr>\n    </thead>\n    <tbody>\n        {% for row in doc.items %}\n        <tr>\n            <td style=\"text-align: center;\">{{ row.idx }}</td>\n            <td><b>{{ row.item_code }}</b><br>{{ row.description }}</td>\n            <td style=\"text-align: center;\">{{ row.gst_hsn_code }}</td>\n            <td style=\"text-align: right;\">{{ row.qty }}</td>\n             <td style=\"text-align: right;\">{{ row.uom }}</td>\n            <td style=\"text-align: right;\">{{ row.rate }}</td>\n            <td style=\"text-align: right;\">{{ row.get_formatted(\"amount\", doc) }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Total -->\n        <tr>\n            <td colspan=\"6\" style=\"text-align: right;\"><b>Total Taxable Value</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"total\") }}</b></td>\n        </tr>\n\n        <!-- Taxes -->\n        {% for tax in doc.taxes %}\n        <tr>\n            <td colspan=\"6\" style=\"text-align: right;\"><b>{{ tax.description }} </b></td>\n            <td style=\"text-align: right;\">{{ tax.get_formatted(\"tax_amount\", doc) }}</td>\n        </tr>\n        {% endfor %}\n\n        <!-- Grand Total -->\n        <tr>\n            <td colspan=\"6\" style=\"text-align: right;\"><b>Grand Total</b></td>\n            <td style=\"text-align: right;\"><b>{{ doc.get_formatted(\"rounded_total\") }}</b></td>\n        </tr>\n\n        <!-- In Words -->\n        <tr>\n            <td colspan=\"7\"><b>Total (in words):</b> {{ doc.in_words or \"\" }}</td>\n        </tr>\n    </tbody>\n</table>\n\n<!-- Terms & Conditions -->\n\n<!-- Signature -->\n<table width=\"100%\" border=\"1\" style=\"border-collapse: collapse;\">\n    <tr>\n    <td colspan=\"2\" style=\"font-weight: bold;\" >\n      Bank Details : -  \n    </td>\n    </tr>\n      <tr>\n        <td width=\"50%\"><b>Bank Name</b></td>\n        <td width=\"50%\">ICICI Bank</td>\n    </tr>\n    <tr>\n        <td width=\"50%\"><b>Account Name</b></td>\n        <td width=\"50%\">SM Renergy Private Limited</td>\n    </tr>\n    <tr>\n        <td><b>Bank Account No.</b></td>\n         <td>249405002208</td>\n    </tr>\n    <tr>\n        <td><b>IFSC Code</b></td>\n         <td>ICIC0002429</td>\n    </tr>\n    <tr>\n        <td><b>Branch Address</b></td>\n         <td>Seetammadhara Branch</td>\n    </tr>\n   \n</table>\n<table width=\"100%\" border=\"1\" style=\"font-size:11px;\">\n    <tr>\n        <td width=\"60%\"><b>Terms & Conditions</b><br><br>\n    <div style=\"font-style:italic;ont-size:11px;text-align:justify;\">\n       {{doc.terms or \"\"}}\n    </div></td>\n        <td width=\"40%\"> <div style=\"text-align:center;\">\n        <link href=\"https://fonts.googleapis.com/css2?family=Dancing+Script&display=swap\" rel=\"stylesheet\">\n        <p style=\"margin:0; font-style:italic; font-weight:bold;font-size:22px;font-family: 'Dancing Script', cursive;\">\n            Signature\n        </p>\n        <p><div style=\"width:50%;margin-left: 25%;\"><img src=\"/files/SMR Delhi Stamp.png\" with=\"20%\"></div></p>\n        <p style=\"font-size:10px;\"><b>For {{ doc.company }}</b></p>\n    </div></td>\n</tr>\n    \n</table>\n\n<!-- Footer -->\n<div id=\"footer-html\" class=\"visible-pdf\" style=\"font-size: 8px; line-height: 1.2;\">\n     <p style=\"text-align: center;\">Computer generated document - Signature not mandatory</p>\n    {% if not no_letterhead and footer %}\n    <div class=\"letter-head-footer\">{{ footer }}</div>\n    {% endif %}\n    <p class=\"text-center small page-number visible-pdf\">\n        {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n    </p>\n</div>\n",
