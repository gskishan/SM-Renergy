 "html": "<style>\n    p {\n        text-align: justify;\n    }\n</style>\n<style>\n.header-block {\n    display: flex;\n    justify-content: space-between; /* logo left, text right */\n    align-items: flex-start;\n}\n\n.logo-left img {\n    width: 30%; /* logo size */\n    height: auto;\n}\n\n.company-text {\n    font-size: 12px; /* slightly bigger font */\n    line-height: 1.3; /* slightly more spacing for readability */\n    text-align: right; /* align text to the right edge */\n    margin-top:0%\n}\n</style>\n\n<div class=\"header-block\">\n    <!-- Logo on the left -->\n    <div class=\"logo-left\">\n        \n    </div>\n\n    <!-- Company text on the right -->\n    <div class=\"company-text\">\n       \n    </div>\n</div>\n\n\n<div id=\"header-html\" class=\"hidden-pdf\">\n    <div class=\"letter-head\">\n        <table width=\"100%\">\n            <tr>\n                <td width=\"40%\" style=\"font-size:12px; text-align:left;\">\n                    <img src=\"{{ '/files/SM Renergy Logo.png' | abs_url }}\" \n                         width=\"70%\" \n                         alt=\"Company Logo\">\n                </td>\n\n                <td width=\"60%\" style=\"font-size:12px; text-align:right;\">\n                    <b>SM Renergy Private Limited</b><br>\n                    86-A, 1st Floor, Randhir Complex<br>\n                    Shahpur Jat, New Delhi<br>\n                    South Delhi, State Code: 07<br>\n                    <b>PIN Code:</b> 110049<br>\n                    <b>GSTIN:</b> 07AAGCS0062H1ZK\n                </td>\n            </tr>\n        </table>\n    </div>\n</div>\n<table width=\"100%\" border=\"1\">\n    <tr>\n        <td colspan=\"3\" style=\"text-align:center;font-weight:bold;font-size:18px;\">Delivery Note</td>\n    </tr>\n    <tr>\n        <td colspan= \"3\"><b>Delivery Note No.</b>{{doc.name}}</td>\n    </tr>\n    <tr>\n        <td width = \"50%\" rowspan=\"2\"><b>Customer Name : </b> {{doc.customer_name or \"\"}}</td>\n        <td width = \"25%\" style=\"border-bottom-style:hidden;border-right-style:hidden;\"><b>Date :</b> {{ doc.get_formatted(\"posting_date\") }}</td>\n        <td width = \"25%\" style=\"border-bottom-style:hidden;\"><b>PO No/Refrence No. :</b>{{doc.po_no or \"\"}}</td>\n    </tr>\n    <tr>\n        <td width = \"25%\" style=\"border-right-style:hidden;\"><b>Project Number :</b> {{doc.project or \"\"}}</td>\n        <td width = \"25%\"><b>LR No. :</b>{{doc.lr_no or \"\"}}</td>\n    </tr>\n    <tr>\n        <td width = \"50%\"><b>Billing Address</b> <br>{{doc.address_display or \"\"}}</td>\n        <td width = \"50%\" colspan = \"2\"><b>Company Address</b> <br>{{doc.company_address_display or \"\"}}</td>\n    </tr>\n    <tr>\n        <td width = \"50%\"><b>Shipping Address</b> <br>{{doc.shipping_address or \"\"}}</td>\n        <td width = \"50%\" colspan = \"2\"></td>\n    </tr>\n    <tr>\n        <td width = \"50%\"><b>Contact Person :</b> {{doc.contact_person or \"\"}}<br><b>Mobile No. </b> {{doc.contact_mobile or \"\"}}</td>\n        <td width = \"50%\" colspan = \"2\"></td>\n    </tr>\n</table>\n<table width=\"100%\" border=\"1\">\n    <thead>\n    <tr style=\"font-weight:bold;text-align:center;\">\n        <td width=\"5%\">Sl No</td>\n        <td width=\"15%\">Item Code</td>\n        <td width=\"30%\">Description</td>\n        <td width=\"15%\">Qty</td>\n        <td width=\"15%\">Rate</td>\n        <td width=\"15%\">Total</td>\n    </tr>\n    </thead>\n    <tbody>\n        {% for item in doc.items %}\n        <tr>\n            <td>{{item.idx or \"\"}}</td>\n            <td>{{item.item_code or \"\"}}</td>\n            <td>{{item.description or \"\"}}</td>\n            <td style=\"text-align:right;\">{{item.qty or \"\"}}</td>\n            <td style=\"text-align:right;\">{{item.rate or \"\"}}</td>\n            <td style=\"text-align:right;\">{{ item.get_formatted(\"amount\", doc )}}</td>\n        </tr>\n        {% endfor %}\n        <tr>\n            <td colspan=\"3\" style=\"text-align:right;\"><b>Total Quantity</b></td>\n            <td style=\"text-align:right;\">{{doc.total_qty or \"\"}}</td>\n            <td><b>Total</b></td>\n            <td style=\"text-align:right;\">{{ doc.get_formatted(\"total\") }}</td>\n        </tr>\n        {% if doc.taxes %}\n        {% for tax in doc.taxes %}\n        <tr>\n            <td  colspan = \"4\" style=\"border-bottom-style:hidden;\"></td>\n            <td ><b>{{tax.description or \"\"}}{% if tax.rate %} @{{tax.rate or \"\"}} % {% endif %}</b></td>\n            <td style=\"text-align:right;\">{{ tax.get_formatted(\"tax_amount\", doc )}}</td>\n        </tr>\n        {% endfor %}\n        {% endif %}\n        <tr>\n            <td  colspan = \"4\"  style=\"border-bottom-style:hidden;\"></td>\n            <td ><b>General Total:\t</b></td>\n            <td style=\"text-align:right;\">{{ doc.get_formatted(\"grand_total\" )}}</td>\n        </tr>\n         <tr>\n            <td  colspan = \"4\"  style=\"border-bottom-style:hidden;\"></td>\n            <td ><b>Rounded Total:\t</b></td>\n            <td style=\"text-align:right;\">{{ doc.get_formatted(\"rounded_total\" )}}</td>\n        </tr>\n         <tr>\n            <td colspan = \"7\"><b>Total In Words\t</b> : {{ doc.in_words or \"\"}}</td>\n        </tr>\n        <tr>\n            <td colspan = \"6\" style =\"text-align: justify;\"><b>Important Note:\t</b> If there is any discrepancy, please revert within 3 days from the date of receipt; \n        otherwise, the material delivered will be considered in full and in good condition.\t\t\t\t</td>\n        </tr>\n    </tbody>\n</table>\n\n<div id=\"footer-html\" class=\"visible-pdf\">\n  {% if not no_letterhead and footer %}\n  <div class=\"letter-head-footer\">\n    {{ footer }}\n  </div>\n  {% endif %}\n  <p class=\"text-center small page-number visible-pdf\">\n    {{ _(\"Page {0} of {1}\").format('<span class=\"page\"></span>', '<span class=\"topage\"></span>') }}\n  </p>\n</div>\n",
